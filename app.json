{
  "expo": {
    "name": "FocusFlow",
    "slug": "focusflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "focusflow",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "experiments": {"typedRoutes": true},
    "ios": {"supportsTablet": true},
    "android": {"adaptiveIcon": {"backgroundColor": "#0F172A"}},
    "web": {"bundler": "metro"}
  }
}
